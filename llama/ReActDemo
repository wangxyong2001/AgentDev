# ==========================================
# 0. 协议加载器 — 从 YAML 模板加载交互格式
# ==========================================

class ProtocolLoader:
    """
    从 YAML 模板文件加载 ReAct 交互协议。

    设计目的:
      将 Agent↔LLM↔User 三方交互的数据格式从硬编码中解耦。
      切换模型、调整输出格式只需修改 YAML 文件，无需改动任何 Python 代码。

    YAML 协议定义三个 Section:
      Section 1 (prompt):   Agent 发给 LLM 的完整 prompt 结构
        - system 段: 角色描述 + 格式规则 + 工具定义 (固定前缀, 每轮不变)
        - user 段:   用户问题 (每轮可变)
        - history 段: 累积的 Thought/Action/Observation 历史 (逐步增长)
        - trigger:   引导模型开始输出的触发词 (如 "Thought:")
      Section 2 (response): LLM 回复的解析规则
        - stop_sequences:  停止生成的 token 列表
        - preprocessing:   输出预处理 (如清除 Qwen 的 <think> 标签)
        - parsing:         正则表达式 + 回退策略 (按优先级 P1~P4 解析)
      Section 3 (output):  Agent 返回给用户的格式化输出模板

    用法示例:
      >>> protocol = ProtocolLoader("ReActProtocol.yaml")
      >>> prompt = protocol.render_full_prompt(tools, question, history)
      >>> parsed = protocol.parse_response(llm_output, tools)
      >>> log_line = protocol.fmt("agent_start")
    """

    def __init__(self, yaml_path: str):
        """
        加载并解析 YAML 协议文件。

        参数:
          yaml_path: YAML 协议文件的绝对路径或相对路径

        初始化流程:
          1. 检查 pyyaml 是否可用, 不可用则抛出 ImportError
          2. 使用 yaml.safe_load() 加载文件内容到 self.cfg
          3. 分离三个子配置: prompt_cfg / response_cfg / output_cfg
          4. 预编译所有解析正则表达式 (提升运行时性能)

        异常:
          ImportError: pyyaml 未安装
          FileNotFoundError: YAML 文件不存在
          yaml.YAMLError: YAML 格式错误
          KeyError: YAML 缺少必需的 Section
        """
        if yaml is None:
            raise ImportError("pyyaml required. Run: pip install pyyaml")
        with open(yaml_path, 'r', encoding='utf-8') as f:
            self.cfg = yaml.safe_load(f)

        self.prompt_cfg = self.cfg["prompt"]
        self.response_cfg = self.cfg["response"]
        self.output_cfg = self.cfg["output"]
        self._compile_patterns()

    # -----------------------------------------------------------------
    # 模板渲染 — 将结构化数据按协议填充到模板中
    # -----------------------------------------------------------------

    def render_system_prompt(self, tools) -> str:
        """
        渲染 System Prompt 段 — prompt 中唯一固定不变的部分。

        组成:
          1. 角色描述 (YAML: sections.system.role)
          2. 格式规则 (YAML: sections.system.format_rules) — 可引用 {tool_names}
          3. 工具列表 (YAML: sections.system.tool_item_format) — 逐个格式化

        参数:
          tools: langchain @tool 装饰的工具函数列表 (需有 .name 和 .description 属性)

        返回:
          完整的 system prompt 文本, 不含 chat_template 包裹标签 (由 render_full_prompt 统一包裹)

        设计意图:
          此段内容在整个会话中完全不变, 是 KV-cache 的最佳复用对象。
        """
        s = self.prompt_cfg["sections"]["system"]
        tool_names = ', '.join([t.name for t in tools])
        tool_items = "\n".join([
            s["tool_item_format"].format(name=t.name, description=t.description)
            for t in tools
        ])

        rules = "\n".join([
            r.format(tool_names=tool_names) for r in s["format_rules"]
        ])

        return f"""{s['role']}
{rules}

{s['tools_header']}
{tool_items}"""

    def render_user_message(self, question: str) -> str:
        """
        渲染 User Message 段 — 每轮可变的问题或 Observation 反馈。

        参数:
          question: 用户原始问题 或 上轮 Observation 注入的新指令

        返回:
          填充后的 user message 文本
        """
        tpl = self.prompt_cfg["sections"]["user"]["template"]
        return tpl.format(question=question)

    def render_history_entry(self, thought: str, action: str,
                              action_input: str, observation: str) -> str:
        """
        渲染单条 ReAct 历史记录 — Thought/Action/ActionInput/Observation 四元组。

        参数:
          thought:      模型输出的推理过程
          action:       模型选择的工具名 (或 "final_answer" / "none")
          action_input: 传给工具的参数
          observation:  工具执行结果 (或 parse error 信息)

        返回:
          按协议模板格式化后的历史条目字符串

        说明:
          每轮 ReAct 完成后调用此方法, 生成一条新的历史条目,
          附加到 prompt 的 assistant 段中, 供下一轮 LLM 调用时参考。
        """
        tpl = self.prompt_cfg["sections"]["history"]["entry_format"]
        return tpl.format(thought=thought, action=action,
                          action_input=action_input, observation=observation)

    def render_full_prompt(self, tools, question: str, history: str) -> str:
        """
        渲染发送给 LLM 的完整 ReAct Prompt。

        组装顺序:
          <|im_start|>system     ← render_system_prompt(tools)
          {system_content}
          <|im_end|>
          <|im_start|>user       ← render_user_message(question)
          {user_content}
          <|im_end|>
          <|im_start|>assistant  ← 历史记录 + 本轮触发
          {history_text}           (上一轮及之前的所有 Thought/Action/Observation)
          Thought:                 (引导模型开始输出)

        参数:
          tools:    工具列表
          question: 用户问题或 Observation 反馈
          history:  已累积的历史记录字符串 (多行)

        返回:
          完整的 prompt 字符串, 可直接送入 llama_cpp.Llama().__call__()
        """
        d = self.prompt_cfg["delimiters"]
        system = self.render_system_prompt(tools)
        user_msg = self.render_user_message(question)
        trigger = self.prompt_cfg["sections"]["trigger"]

        return (
            f"{d['system_start']}{system}{d['system_end']}\n"
            f"{d['user_start']}{user_msg}{d['user_end']}\n"
            f"{d['assistant_start']}{history}\n"
            f"{trigger}"
        )

    # -----------------------------------------------------------------
    # 响应解析 — 从 LLM 的原始文本输出中提取结构化数据
    # -----------------------------------------------------------------

    def _compile_patterns(self):
        """
        预编译所有解析用正则表达式。

        为什么预编译:
          ReAct 循环中每轮都要解析 LLM 输出, 预编译可以避免重复编译开销。
          4 个正则分别对应: Final Answer / Thought / Action / Action Input

        正则标志映射:
          YAML 中用字符串表示 flag (如 "DOTALL"), 此处映射为 re 模块常量。
          支持的 flag: DOTALL (跨行匹配), MULTILINE, IGNORECASE
        """
        pp = self.response_cfg["parsing"]
        flags_map = {"DOTALL": re.DOTALL, "MULTILINE": re.MULTILINE, "IGNORECASE": re.IGNORECASE}

        def _flags(flist):
            f = 0
            for name in (flist or []):
                f |= flags_map.get(name, 0)
            return f

        self._re_final = re.compile(pp["final_answer"]["pattern"], _flags(pp["final_answer"].get("flags")))
        self._re_thought = re.compile(pp["thought"]["pattern"], _flags(pp["thought"].get("flags")))
        self._re_action = re.compile(pp["action"]["pattern"])
        self._re_action_input = re.compile(pp["action_input"]["pattern"], _flags(pp["action_input"].get("flags")))

    def preprocess_output(self, raw: str) -> str:
        """
        LLM 原始输出预处理 — 清除模型特定的包装标签。

        处理内容:
          - Qwen 思考模型的 <think>...</think> 标签 (内部推理, 对 Agent 无用)
          - <response> / </response> 包装标签
          - 其他在 YAML preprocessing.strip_tags 中配置的标签

        参数:
          raw: LLM 返回的原始文本 (可能包含模型特有的 XML 标签)

        返回:
          去除包装标签后的纯文本

        注意:
          预处理后的文本可能为空字符串, 此时由 parse_response 回退处理。
        """
        pp = self.response_cfg["preprocessing"]
        cleaned = raw
        for tag in pp.get("strip_tags", []):
            cleaned = re.sub(tag, '', cleaned, flags=re.DOTALL)
        return cleaned.strip()

    def parse_response(self, output: str, tools) -> Dict[str, str]:
        """
        按协议定义的优先级解析 LLM 输出 — P1~P4 四级回退。

        解析优先级:
          P1: 检测 "Final Answer:" → 直接返回最终答案, 终止 ReAct 循环
          P2: 提取 "Thought:"  → 模型推理过程 (可选, 某些模型会跳过)
          P3: 提取 "Action:"   → 模型选择的工具名 (必须, 否则触发回退策略)
          P4: 提取 "Action Input:" → 传给工具的参数

        回退策略:
          - Action 正则匹配失败时 → 在文本中扫描已注册的工具名
          - Action Input 匹配失败时 → 取 Action 行之后的第一行文本
          - Thought 匹配失败时   → 取输出的第一行作为 thought
          - 所有回退都失败        → 抛出 ValueError (由调用方触发 Error Recovery)

        参数:
          output: 经过 preprocess_output 清洗后的 LLM 输出文本
          tools:  已注册的工具列表 (用于回退时的工具名匹配)

        返回:
          {"thought": str, "action": str, "action_input": str}
          - action 为 "final_answer" 时, action_input 即为最终答案
          - action 为 "none" 时, 表示解析完全失败

        异常:
          ValueError: 所有解析策略均失败 (模型输出完全不遵循协议)
        """
        clean = self.preprocess_output(output)
        if not clean:
            clean = output.strip()

        # P1: Final Answer — 最高优先级, 直接返回
        fa = self._re_final.search(clean)
        if fa:
            return {
                "thought": "I now know the final answer",
                "action": "final_answer",
                "action_input": fa.group(1).strip()
            }

        # P2: Thought — 可选字段, 提取失败时用第一行回退
        thought = ""
        tm = self._re_thought.search(clean)
        if tm:
            thought = tm.group(1).strip()
        elif self.response_cfg["parsing"]["thought"].get("fallback") == "first_line":
            thought = clean.split('\n')[0].strip()

        # P3: Action — 必须字段, 失败时触发工具名回退匹配
        am = self._re_action.search(clean)
        if not am:
            # fallback: 在输出文本中逐一扫描已注册工具的名称
            for t in tools:
                if t.name in clean:
                    m = re.search(rf"{t.name}\s*(.*)", clean)
                    return {
                        "thought": thought or clean.split('\n')[0].strip(),
                        "action": t.name,
                        "action_input": m.group(1).strip().strip('()"\'') if m else clean.strip()
                    }
            # 所有策略均失败 — 模型输出完全不可解析
            raise ValueError(f"No 'Action:' found in LLM output. Got: {clean[:200]}")
        action = am.group(1).strip()

        # P4: Action Input — 可选字段, 失败时取 Action 后面的文本
        aim = self._re_action_input.search(clean)
        if aim:
            action_input = aim.group(1).strip()
        else:
            rest = clean[am.end():].strip()
            action_input = rest.split('\n')[0].strip() if rest else ""

        if not thought:
            thought = clean.split('\n')[0].strip() or "(reasoning)"

        return {
            "thought": thought,
            "action": action,
            "action_input": action_input
        }

    # -----------------------------------------------------------------
    # 输出格式化 — 从模板渲染终端日志 & 对外输出
    # -----------------------------------------------------------------

    def fmt(self, key: str, **kwargs) -> str:
        """
        从 YAML output.terminal 段按 key 取模板, 用 kwargs 填充后返回。

        用法:
          protocol.fmt("agent_start")          → "[AGENT] === ReAct loop start ==="
          protocol.fmt("step_header", step=3)  → "[STEP 3] --------------------------------------------------"
          protocol.fmt("llm_tokens", prompt_tokens=100, completion_tokens=20, duration_ms="500")

        参数:
          key:    YAML output.terminal 下的模板键名
          kwargs: 模板中的 {placeholder} 替换值

        返回:
          填充后的字符串; 如果 key 在 YAML 中不存在, 返回空字符串 (由调用方回退到硬编码格式)
        """
        tpl = self.output_cfg["terminal"].get(key, "")
        if not tpl:
            return ""
        return tpl.format(**kwargs)

    @property
    def stop_sequences(self) -> List[str]:
        """
        LLM 生成停止序列列表。

        来源: YAML response.stop_sequences
        用途: 传给 llama_cpp.Llama().__call__(stop=...), 控制模型在合适位置停止生成。
              例如遇到 "Observation:" 时停止, 因为那是工具执行结果, 不应由模型生成。
        """
        return self.response_cfg.get("stop_sequences", [])

    @property
    def gen_params(self) -> Dict[str, Any]:
        """
        LLM 生成参数。

        来源: YAML response.generation
        包含: max_tokens, temperature 等, 用于控制生成行为。
        """
        return self.response_cfg.get("generation", {})

    @property
    def max_steps(self) -> int:
        """
        ReAct 循环最大步数 (安全阀)。

        来源: YAML response.generation.max_steps
        默认: 8
        用途: 防止模型在无法收敛时无限循环, 达到上限后强制终止。
        """
        return self.response_cfg.get("generation", {}).get("max_steps", 8)


