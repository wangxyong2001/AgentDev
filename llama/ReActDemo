def clean_qwen_output(raw_text: str) -> str:
    """
    清理 Qwen 思考模型的输出标签 — 提取纯文本。

    Qwen3.6 思考模型的原始输出格式:
      <think>内部推理过程 (对 Agent 无用, 应清除)</think>
      <response>结构化输出 (Thought/Action/Action Input)</response>

    清洗步骤:
      1. 移除 <think>...</think> 标签及其全部内容 (正则 .*? 非贪婪 + re.DOTALL 跨行)
      2. 移除残留的 <response> / </response> / </think> 空标签
      3. 去除首尾空白字符

    参数:
      raw_text: LLM 返回的原始文本 (可能包含 Qwen 思考标签)

    返回:
      清洗后的纯文本; 若模型未输出 think/response 标签, 清洗后与原始文本基本相同

    注意:
      如果 prompt 中已禁止使用 <think> 标签 (如 YAML 模板中的约束),
      此函数的清洗可能不产生任何效果 (模型输出中本就没有这些标签)。
    """
    # 移除  标签及其内容（保留标签后的内容）
    cleaned = re.sub(r'<think>.*?</think>', '', raw_text, flags=re.DOTALL)
    # 移除  response 和  标签
    cleaned = re.sub(r'<response>|</response>|<\s*/\s*think\s*>', '', cleaned, flags=re.DOTALL)
    return cleaned.strip()


def get_react_prompt(question: str, history: List[str]) -> str:
    """
    构建 ReAct 格式的 Prompt — 内置回退实现。

    与 ProtocolLoader.render_full_prompt() 功能相同, 但使用硬编码模板。
    当 ReActProtocol.yaml 不可用时 (如 pyyaml 未安装), 自动回退到此函数。

    参数:
      question: 用户问题 或 Observation 反馈注入的新指令
      history:  历史记录列表 (每项为一条 Thought/Action/ActionInput/Observation)

    返回:
      完整 prompt 字符串, 可直接送入 llama_cpp.Llama().__call__()

    模板结构 (Qwen2 chat_template):
      <|im_start|>system     ← ReAct 规则 + 可用工具列表 (固定前缀, 每轮不变)
      <|im_start|>user       ← 用户问题 (每轮可变, 携带最新 Observation)
      <|im_start|>assistant  ← 累积历史记录 + "Thought:" 触发词 (让模型续写)
    """
    tools_desc = "\n".join([f"- {t.name}: {t.description}" for t in TOOLS])
    tool_names = ', '.join([t.name for t in TOOLS])
    history_str = "\n".join(history) if history else ""

    # 使用 Qwen 能更好理解的格式，加入更强的格式约束
    prompt = f"""<|im_start|>system
You are a ReAct agent. You MUST follow the EXACT format below. Do NOT add extra explanations, do NOT use <think> tags, just follow the format:

Format rules:
- After "Thought:" write your reasoning in ONE line
- After "Action:" write ONLY the tool name: {tool_names}
- After "Action Input:" write the tool input
- After you have the answer, use "Final Answer:"

Available tools:
{tools_desc}<|im_end|>
<|im_start|>user
{question}<|im_end|>
<|im_start|>assistant
{history_str}
Thought:"""

    return prompt


def parse_llm_output(output: str) -> Dict[str, str]:
    """
    解析 LLM 输出 — 内置回退实现 (四级解析 + 工具名回退)。

    与 ProtocolLoader.parse_response() 功能相同, 但使用硬编码正则表达式。

    解析优先级 (P1~P4):
      P1: 检测 "Final Answer:"  → 直接返回最终答案, 终止 ReAct 循环
      P2: 提取 "Thought:"       → 模型的推理过程 (可选字段)
      P3: 提取 "Action:"        → 模型选择的工具名 (必须字段, 失败时触发工具名回退)
      P4: 提取 "Action Input:"  → 传给工具的参数 (可选字段)

    回退策略:
      - Action 正则失败:  在输出文本中扫描已注册工具的名称
      - Action Input 失败: 取 Action 行之后的第一行非空文本
      - Thought 失败:      取输出的第一行作为 Thought

    参数:
      output: LLM 返回的文本 (未清洗, 函数内部会先调用 clean_qwen_output)

    返回:
      {"thought": str, "action": str, "action_input": str}

    异常:
      ValueError: 所有解析策略均失败 (模型输出完全不遵循 ReAct 协议)
    """
    # 0. 清理 Qwen 思考标签
    clean = clean_qwen_output(output)
    if not clean:
        clean = output.strip()

    # Step 1: P1 检测 Final Answer — 最高优先级, 命中即终止 ReAct 循环
    fa_match = re.search(r"Final Answer:\s*(.*)", clean, re.DOTALL)
    if fa_match:
        final_answer = fa_match.group(1).strip()
        return {
            "thought": "I now know the final answer",
            "action": "final_answer",
            "action_input": final_answer
        }

    # Step 2: P2 提取 Thought — 模型的推理过程 (可选字段)
    thought = ""
    thought_match = re.search(r"Thought:\s*(.+?)(?=\n(?:Action|Final)|$)", clean, re.DOTALL)
    if thought_match:
        thought = thought_match.group(1).strip()

    # Step 3: P3 提取 Action — 必须字段 (工具名)
    action_match = re.search(r"Action:\s*(\S+)", clean)
    if not action_match:
        # ── 回退策略: 在输出文本中扫描已注册工具的名称 ──
        for t in TOOLS:
            if t.name in clean:
                action_match = re.search(rf"{t.name}\s*(.*)", clean)
                if action_match:
                    return {
                        "thought": thought or clean.split('\n')[0].strip(),
                        "action": t.name,
                        "action_input": action_match.group(1).strip().strip('()"\'') or clean.strip()
                    }
        raise ValueError(f"No 'Action:' found in LLM output. Got: {clean[:200]}")

    action = action_match.group(1).strip()

    # Step 4: P4 提取 Action Input — 传给工具的参数 (可选字段)
    ai_match = re.search(r"Action Input:\s*(.+?)(?=\n(?:Thought|Action|Final|Observation)|$)", clean, re.DOTALL)
    if ai_match:
        action_input = ai_match.group(1).strip()
    else:
        # ── 回退策略: 取 Action 行之后的第一行文本作为 Input ──
        rest = clean[action_match.end():].strip()
        action_input = rest.split('\n')[0].strip() if rest else ""

    # ── 兜底: 若 Thought 仍未提取到, 用输出第一行 ──
    if not thought:
        first_line = clean.split('\n')[0].strip()
        thought = first_line if first_line else "(reasoning)"

    return {
        "thought": thought,
        "action": action,
        "action_input": action_input
    }

def run_react_agent(llm: Llama, question: str, max_steps: int = MAX_STEPS,
                     tracer: Optional['LlamaTracer'] = None,
                     protocol: Optional['ProtocolLoader'] = None):
    """
    运行 ReAct Agent 主循环 — 支持 YAML Protocol 驱动。

    这是整个 ReAct 系统的核心控制循环, 负责:
      1. Prompt 构建: 调用 protocol.render_full_prompt() 或内置 get_react_prompt()
      2. LLM 推理: 调用 llama_cpp.Llama() 发送 prompt 并接收原始输出
      3. 输出解析: 调用 protocol.parse_response() 或内置 parse_llm_output()
      4. 工具执行: 匹配并调用已注册的 langchain @tool 函数
      5. 历史管理: 将每轮的 Thought/Action/Observation 追加到历史列表
      6. 循环控制: 检测 Final Answer 终止, 或达到 max_steps 上限

    双路径设计:
      当 protocol 参数非 None 时 (加载了 YAML 协议模板):
        - prompt 构建 / response 解析 / 日志输出 全部由协议模板驱动
        - 可通过修改 YAML 文件切换模型、调整格式, 无需改代码
      当 protocol 参数为 None 时 (YAML 不可用):
        - 回退到内置的 get_react_prompt() / parse_llm_output() / 硬编码日志格式
        - 保证脚本在任何环境下都能独立运行

    参数:
      llm:       已初始化的 llama_cpp.Llama 实例
      question:  用户问题字符串
      max_steps: 最大 ReAct 循环步数 (安全阀, 防止无限循环)
      tracer:    LlamaTracer 实例 (可选, 用于全量数据追踪)
      protocol:  ProtocolLoader 实例 (可选, 用于 YAML 协议驱动)

    返回:
      最终答案字符串 (来自 Final Answer), 或 "Agent stopped due to max steps."
    """

    if protocol is None:
        proto_path = os.path.join(TRACE_OUTPUT_DIR, "ReActProtocol.yaml")
        if os.path.exists(proto_path):
            protocol = ProtocolLoader(proto_path)

    # ── 函数指针: 有 protocol 则用 protocol 方法, 否则回退到内置函数 ──
    _render_prompt = (lambda q, h: protocol.render_full_prompt(TOOLS, q, "\n".join(h) if h else "")) \
        if protocol else (lambda q, h: get_react_prompt(q, h))
    _preprocess = protocol.preprocess_output if protocol else clean_qwen_output
    _parse = (lambda out: protocol.parse_response(out, TOOLS)) if protocol else parse_llm_output
    _stop = protocol.stop_sequences if protocol else ["Observation:", "\n<|im_end|>", "<|im_end|>"]
    _fmt = protocol.fmt if protocol else (lambda k, **kw: "")

    history = []
    current_input = question

    ts_print(_fmt("agent_start") or f"\n[AGENT] === ReAct loop start ===")
    ts_print(_fmt("agent_question", question=question) or f"[AGENT] Question: {question}\n")

    for step in range(1, max_steps + 1):
        ts_print(_fmt("step_header", step=step) or f"[STEP {step}] --------------------------------------------------")
        t_start = time.time()

        # ═══ Step 1: 构建 Prompt 并调用 LLM ═══
        prompt = _render_prompt(current_input, history)

        response = llm(
            prompt,
            max_tokens=512,
            stop=_stop,
            temperature=TEMPERATURE
        )
        duration_ms = (time.time() - t_start) * 1000

        raw_output = response["choices"][0]["text"]
        llm_output = _preprocess(raw_output)

        # ── 获取 token 用量 (来自 llama.cpp usage 字段) ──
        usage = response.get("usage", {})
        prompt_tokens = usage.get("prompt_tokens", len(prompt) // 4)
        completion_tokens = usage.get("completion_tokens", len(raw_output) // 4)

        ts_print(_fmt("llm_raw", raw_output=raw_output[:200]) or f"[LLM] Raw: {raw_output[:200]}")
        ts_print(_fmt("llm_tokens", prompt_tokens=prompt_tokens,
                    completion_tokens=completion_tokens, duration_ms=f"{duration_ms:.0f}")
              or f"[LLM] tokens: prompt={prompt_tokens}  completion={completion_tokens}  duration={duration_ms:.0f}ms")

        # ═══ Step 2: 解析 LLM 输出 ═══
        parse_error = None
        try:
            parsed = _parse(llm_output)
        except ValueError as e:
            ts_print(_fmt("error_parse", error=str(e)) or f"[ERROR] Parse failed: {e}")
            parse_error = str(e)
            # ── Error Recovery: 将解析失败的输出作为 Observation 反馈给模型, 让它重试 ──
            if tracer:
                tracer.record_turn(
                    turn=step, question=question, prompt=prompt,
                    raw_output=raw_output, cleaned_output=llm_output,
                    thought="(Parse Error)", action="none", action_input="none",
                    observation=llm_output,
                    prompt_tokens=prompt_tokens, completion_tokens=completion_tokens,
                    duration_ms=duration_ms, parse_error=parse_error, status="parse_error"
                )
            history.append(
                f"Thought: (Parse Error)\n"
                f"Action: none\n"
                f"Action Input: none\n"
                f"Observation: {llm_output}"
            )
            current_input = f"Based on the observation, try again.\nObservation: {llm_output}"
            continue

        thought = parsed["thought"]
        action = parsed["action"]
        action_input = parsed["action_input"]

        ts_print(_fmt("trace_thought", thought=thought) or f"[TRACE] Thought: {thought}")
        ts_print(_fmt("trace_action", action=action) or f"[TRACE] Action: {action}")
        ts_print(_fmt("trace_input", action_input=action_input) or f"[TRACE] Input: {action_input}")

        # ═══ Step 3: 执行 Action (工具调用 或 返回最终答案) ═══
        if action == "final_answer":
            final_answer = action_input
            ts_print(_fmt("result_final", answer=action_input) or f"\n[RESULT] Final Answer: {final_answer}\n")
            if tracer:
                tracer.record_turn(
                    turn=step, question=question, prompt=prompt,
                    raw_output=raw_output, cleaned_output=llm_output,
                    thought=thought, action=action, action_input=action_input,
                    observation="(final answer)",
                    prompt_tokens=prompt_tokens, completion_tokens=completion_tokens,
                    duration_ms=duration_ms, status="success"
                )
            return final_answer

        # ── 在已注册的工具列表中查找匹配的工具函数 ──
        tool_obj = next((t for t in TOOLS if t.name == action), None)

        tool_error = False
        if not tool_obj:
            observation = f"Unknown action: '{action}'. Available actions: {[t.name for t in TOOLS]}"
            tool_error = True
        else:
            try:
                observation = tool_obj.invoke(action_input)
            except Exception as e:
                observation = f"Tool execution error: {str(e)}"
                tool_error = True

        ts_print(_fmt("trace_obs", observation=observation) or f"[TRACE] Observation: {observation}\n")

        # ── Trace: 将本轮完整数据记录到追踪器 ──
        if tracer:
            tracer.record_turn(
                turn=step, question=question, prompt=prompt,
                raw_output=raw_output, cleaned_output=llm_output,
                thought=thought, action=action, action_input=action_input,
                observation=observation,
                prompt_tokens=prompt_tokens, completion_tokens=completion_tokens,
                duration_ms=duration_ms,
                status="tool_error" if tool_error else "success"
            )

        # ═══ Step 4: 更新历史记录 (按协议模板格式化) ═══
        if protocol:
            history.append(protocol.render_history_entry(
                thought=thought, action=action,
                action_input=action_input, observation=observation))
        else:
            history.append(
                f"Thought: {thought}\n"
                f"Action: {action}\n"
                f"Action Input: {action_input}\n"
                f"Observation: {observation}\n"
            )

        # ═══ Step 5: 准备下一轮输入 (注入新 Observation) ═══
        current_input = f"Based on the observation, what should I do next?\nObservation: {observation}"

    ts_print(_fmt("warn_max_steps", max_steps=max_steps) or f"[WARN] Max steps ({max_steps}) reached. Loop terminated.")
    return "Agent stopped due to max steps."

