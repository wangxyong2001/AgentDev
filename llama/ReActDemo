@dataclass
class PromptDecomposition:
    """
    将 ReAct prompt 分解为三段结构化数据。

    用途:
      - 追踪各段的字节数变化 (系统段应始终不变, 历史段逐步增长)
      - 支持跨轮 Diff 计算时对比各部分是否变化
      - HTML 报告中折叠展示各段内容

    三段说明:
      system_prompt: 固定不变的 ReAct 规则 + 工具定义 (KV-cache 最佳复用对象)
      user_message:  用户原始问题 或 上一轮 Observation 注入的新指令 (每轮变化)
      history_text:  累积的 Thought/Action/Observation 记录 (每轮递增 4~5 行)
    """
    system_prompt: str     # 固定部分: ReAct 规则 + 工具定义
    user_message: str      # 用户输入 / 本轮 Observation 注入
    history_text: str      # 累积的 Thought/Action/Observation 历史
    full_prompt: str       # 原始完整 prompt (三段拼接后)

    @property
    def system_len(self) -> int:
        """系统提示词的字符长度 (应在整个会话中保持恒定)"""
        return len(self.system_prompt)

    @property
    def user_len(self) -> int:
        """用户消息的字符长度 (每轮因 Observation 不同而变化)"""
        return len(self.user_message)

    @property
    def history_len(self) -> int:
        """历史记录的字符长度 (每轮附加 1 条记录, 逐步增长)"""
        return len(self.history_text)


@dataclass
class TurnDiff:
    """
    相邻两轮 ReAct 调用的全量数据变化对比。

    追踪维度:
      Prompt 层:
        - common_prefix_len: 与上一轮共享的前缀字节数 (逐字符比对)
        - prompt_reuse_pct:  prompt 复用百分比 (≈ cached / total)
        - system_unchanged:  系统提示词是否未变 (应始终 True, 否则为异常)
        - history_lines_added: 本轮新增的历史行数 (正常为 4~5)
        - user_changed:      用户消息是否变化

      Response 层:
        - thought_vs_prev: Thought 与上轮相比: new(首轮) / same(相同) / different(变化)
        - action_vs_prev:  Action 与上轮相比:  new / same / different
        - response_len_delta: 响应长度的变化量 (正=更长, 负=更短)

      Cache 层:
        - cached_tokens: 估算的 KV-cache 命中 token 数 (≈ common_prefix_len / 3.5)
        - new_tokens:    本轮新增 token 数 (需重新计算的)
    """
    turn: int
    # ── Prompt 维度 ──
    common_prefix_len: int        # 与上一轮共享的前缀字符数 (逐字符比对, 系统提示词+历史)
    new_prompt_len: int           # 本轮新增的 prompt 字符数
    prompt_reuse_pct: float       # prompt 复用率 = common_prefix / total * 100 (%)
    system_unchanged: bool        # 系统提示词是否未变化 (正常始终 True, False 表示异常)
    history_lines_added: int      # 本轮比上轮新增的历史行数 (正常每轮 +4~5 行)
    user_changed: bool            # user_message 是否变化 (每轮通常为 True)
    # ── Response 维度 ──
    thought_vs_prev: str          # Thought 比较: "new" (首轮) | "same" | "different"
    action_vs_prev: str           # Action 比较:  "new" (首轮) | "same" | "different"
    response_len_delta: int       # 本轮响应长度 - 上轮响应长度 (字符)
    # ── Cache 估算 ──
    cached_tokens: int            # 估算被 KV-cache 命中的 token 数 (共享前缀部分)
    new_tokens: int               # 估算本轮新增的 token 数 (需全新计算)
    # ── 单行摘要 ──
    summary_line: str             # 例: "reuse 78% | history +5 lines | user changed | Thought:different"


@dataclass
class TraceRecord:
    """
    单轮 ReAct 调用的完整 Trace 记录。

    包含:
      - 原始数据: prompt / raw_output / cleaned_output
      - 解析结果: thought / action / action_input / observation
      - 统计指标: prompt_tokens / completion_tokens / duration_ms
      - 全量分解: decomp (PromptDecomposition) — prompt 拆为三段
      - 跨轮对比: diff (TurnDiff) — 与上一轮的全量差异
      - 错误信息: parse_error (解析失败时) / status (本轮状态)
    """
    turn: int                              # 轮次编号 (从 1 开始)
    question: str                          # 原始用户问题
    timestamp: str                         # 记录时间戳 (精确到毫秒)
    prompt_full: str                       # 完整 prompt (可直接送入 LLM)
    prompt_snapshot: str                   # prompt 尾部快照 (最后 500 字符, 用于快速浏览)
    raw_output: str                        # LLM 原始输出 (未经任何清洗)
    cleaned_output: str                    # 清洗后的输出 (已去除 <think> 等标签)
    thought: str                           # 解析出的推理过程
    action: str                            # 解析出的动作 (工具名 / "final_answer" / "none")
    action_input: str                      # 解析出的动作参数
    observation: str                       # 工具执行结果 (或 "(final answer)")
    prompt_tokens: int                     # prompt 消耗的 token 数 (来自 llama.cpp usage)
    completion_tokens: int                 # 响应消耗的 token 数 (来自 llama.cpp usage)
    duration_ms: float                     # LLM 调用耗时 (毫秒, 含网络/推理延迟)
    # ── 全量数据分解 ──
    decomp: Optional[PromptDecomposition] = None  # prompt 三段分解 (首轮起)
    # ── 跨轮 Diff ──
    diff: Optional[TurnDiff] = None               # 与上一轮的差异 (第 2 轮起有值)
    # ── 错误 ──
    parse_error: Optional[str] = None             # 解析失败时的错误消息
    status: str = "success"                       # success | parse_error | tool_error | max_steps


class LlamaTracer:
    """
    ReAct Agent 调用链全量追踪器。

    追踪维度 (5 个层面):
      1. Prompt 结构分解  — 每轮 prompt 拆为 system / user / history 三段
      2. 跨轮 Diff 对比    — 相邻轮次间全量数据的增量变化 (新增/复用/变化)
      3. Cache 命中率估算  — 基于公共前缀分析, 估算 KV-cache 可复用的 token 占比
      4. Response 变化追踪 — Thought/Action 与上一轮是否相同、响应长度变化
      5. 成本 & Token 统计 — 每轮 token 用量 + 人民币成本估算

    使用方式:
      tracer = LlamaTracer()
      tracer.record_turn(...)   # 每轮 ReAct 调用时记录一次
      tracer.print_summary()    # 终端打印统计摘要
      tracer.export_html(...)   # 导出自包含 HTML 可视化报告

    跨轮持久状态:
      _last_prompt / _last_decomp / _last_response / _last_thought / _last_action
      用于计算相邻轮次的 Diff。
    """

    def __init__(self):
        """
        初始化追踪器。

        设置:
          - 空记录列表 (self.records)
          - 会话开始时间 (self.session_start)
          - 模型名称 (从 MODEL_PATH 提取文件名)
          - 跨轮状态变量 (全部初始化为空, 首轮无上一轮可供对比)
        """
        self.records: List[TraceRecord] = []
        self.session_start = datetime.now()
        self.model_name = os.path.basename(MODEL_PATH)
        # ── 跨轮追踪状态 (用于计算相邻轮次的 Diff) ──
        self._last_prompt: str = ""                           # 上一轮的完整 prompt
        self._last_decomp: Optional[PromptDecomposition] = None  # 上一轮的 prompt 分解
        self._last_response: str = ""                         # 上一轮的清洗后输出
        self._last_thought: str = ""                          # 上一轮的 Thought
        self._last_action: str = ""                           # 上一轮的 Action

    # -----------------------------------------------------------------
    # Prompt 结构分解 — 将完整 prompt 按角色段拆解
    # -----------------------------------------------------------------

    def _decompose_prompt(self, prompt: str) -> PromptDecomposition:
        """
        将 ReAct 格式的 prompt 按 chat_template 分隔符分解为三段。

        输入格式 (Qwen2 chat_template):
          <|im_start|>system\\n{系统提示词}<|im_end|>\\n
          <|im_start|>user\\n{用户消息}<|im_end|>\\n
          <|im_start|>assistant\\n{历史记录}\\nThought:

        分解结果:
          system_prompt: {系统提示词} — 固定不变, 整个会话共享
          user_message:  {用户消息}   — 每轮可变, 携带最新 Observation
          history_text:  {历史记录 + Thought:} — 逐步增长, 携带累积上下文

        参数:
          prompt: render_full_prompt() 生成的完整 prompt 字符串

        返回:
          PromptDecomposition 对象, 包含三段文本及其长度属性

        注意:
          - assistant 段不包含 <|im_end|> 闭合标签 (故意不闭合, 让模型续写)
          - 如果某段匹配失败, 对应字段为空字符串 (不应发生, 除非 prompt 格式异常)
        """
        system_prompt = ""
        user_message = ""
        history_text = ""

        # 提取 system 段: <|im_start|>system\n ... <|im_end|>
        # .*? 非贪婪匹配, re.DOTALL 允许跨行
        sys_match = re.search(r'<\|im_start\|>system\n(.*?)<\|im_end\|>', prompt, re.DOTALL)
        if sys_match:
            system_prompt = sys_match.group(1).strip()

        # 提取 user 段: <|im_start|>user\n ... <|im_end|>
        user_match = re.search(r'<\|im_start\|>user\n(.*?)<\|im_end\|>', prompt, re.DOTALL)
        if user_match:
            user_message = user_match.group(1).strip()

        # 提取 assistant 段: <|im_start|>assistant\n ... (到 prompt 末尾)
        # 注意: assistant 段没有 <|im_end|> 闭合 — 这是故意的设计, 让模型续写
        asst_match = re.search(r'<\|im_start\|>assistant\n(.*)', prompt, re.DOTALL)
        if asst_match:
            history_text = asst_match.group(1).strip()

        return PromptDecomposition(
            system_prompt=system_prompt,
            user_message=user_message,
            history_text=history_text,
            full_prompt=prompt,
        )

    # -----------------------------------------------------------------
    # 跨轮 Diff 计算 — 对比相邻两轮的全量数据变化
    # -----------------------------------------------------------------

    def _compute_diff(self, current: str, prev: str, decomp: PromptDecomposition,
                      prev_decomp: Optional[PromptDecomposition],
                      thought: str, action: str, completion_tokens: int,
                      response_len: int) -> TurnDiff:
        """
        计算本轮与上一轮的全量数据差异 — 这是 Cache 分析的核心算法。

        算法分四个维度:

        1. Prompt 维度 (字符级差异):
           - 公共前缀长度: 从两个 prompt 的起始字符逐位比对, 直到第一个不同字符
             由于 system_prompt 固定 + history 累积, 公共前缀通常 = system + user(部分) + 历史(大部分)
           - prompt 复用率: common_prefix / total_prompt_length × 100%
             Qwen3.6 35B 实测 60-90%, 取决于历史增长速度和 user 变化频率
           - 系统提示词是否变化: 直接字符串比对 (应为 False, 否则是 bug)
           - 历史新增行数: 两轮历史的行数差值 (正常每轮 +4~5 行)

        2. Response 维度 (语义级差异):
           - Thought 变化: 与上一轮的 Thought 字符串对比
             "new" = 首轮, "same" = 模型重复思考, "different" = 正常推理差异
           - Action 变化: 同上, 用于检测模型是否陷入重复调用同一工具的死循环
           - 响应长度 delta: 正数=本轮更长, 负数=本轮更短

        3. Cache 维度 (token 级估算):
           - cached_tokens: common_prefix_len / 3.5 ≈ 可被 KV-cache 命中的 token 数
             中英混合文本约 3.5 字符/token, 这是经验估算值, 非精确计算
           - new_tokens: 本轮新增部分的 token 估算
             这些是 LLM 需要全新计算的内容, 无法从缓存受益

        4. 摘要行: 将上述所有维度压缩为一行可读文本, 用于终端 DIFF 输出

        参数:
          current:           本轮完整 prompt 字符串
          prev:              上一轮完整 prompt 字符串 (首轮为空字符串)
          decomp:            本轮的 prompt 分解结果
          prev_decomp:       上一轮的 prompt 分解结果 (首轮为 None)
          thought/action:    本轮解析出的 Thought 和 Action
          completion_tokens: 本轮响应 token 数 (保留参数, 备用)
          response_len:      本轮清洗后输出的字符长度

        返回:
          TurnDiff 对象, 包含所有维度的差异数据
        """
        turn = len(self.records) + 1

        # ═══ Prompt 维度 — 字符级差异分析 ═══

        # 计算公共前缀长度: 从第一个字符开始逐一比对
        # 复杂度 O(min(len(current), len(prev))), 对 ~700 字符的 prompt 可忽略不计
        common_len = 0
        min_len = min(len(current), len(prev)) if prev else 0
        for i in range(min_len):
            if current[i] == prev[i]:
                common_len = i + 1
            else:
                break

        new_len = len(current) - common_len
        reuse_pct = (common_len / len(current) * 100) if len(current) > 0 else 0.0

        # 系统提示词是否变化 — 直接字符串比对
        # 正常会话中应始终为 True (system prompt 一旦加载就不会变)
        # 如果为 False, 说明 YAML 模板或 tools 列表在会话中发生了不应有的变化
        system_unchanged = True
        if prev_decomp and decomp:
            system_unchanged = (prev_decomp.system_prompt == decomp.system_prompt)

        # 历史新增行数 — 正常每轮附加 4~5 行 (Thought + Action + Action Input + Observation + 空行)
        history_added = 0
        if prev_decomp and decomp:
            prev_lines = prev_decomp.history_text.count('\n')
            curr_lines = decomp.history_text.count('\n')
            history_added = max(0, curr_lines - prev_lines)

        # user_message 是否变化 — 每轮通常都会变化 (注入了新的 Observation)
        user_changed = True
        if prev_decomp and decomp:
            user_changed = (prev_decomp.user_message != decomp.user_message)

        # ═══ Response 维度 — 语义级差异分析 ═══

        thought_vs = "new" if not self._last_thought else (
            "same" if thought == self._last_thought else "different")
        action_vs = "new" if not self._last_action else (
            "same" if action == self._last_action else "different")
        # 响应长度变化 (字符数)
        resp_delta = response_len - len(self._last_response) if self._last_response else response_len

        # ═══ Cache 维度 — token 级估算 ═══

        # 中英混合文本约 3.5 字符/token (基于 Qwen tokenizer 的经验值)
        # 精确值需要调用 tokenizer.encode(), 但开销太大; 3.5 在生产中足够准确
        cached_tokens = int(common_len / 3.5)
        new_token_est = int(new_len / 3.5)

        # ═══ 构建单行摘要 ═══

        parts = [f"reuse {reuse_pct:.0f}%"]
        if history_added > 0:
            parts.append(f"history +{history_added} lines")
        if user_changed:
            parts.append("user changed")
        else:
            parts.append("user same")
        parts.append(f"Thought:{thought_vs}")
        parts.append(f"Action:{action_vs}")
        if resp_delta != 0:
            parts.append(f"resp {resp_delta:+d} chars")

        return TurnDiff(
            turn=turn,
            common_prefix_len=common_len,
            new_prompt_len=new_len,
            prompt_reuse_pct=reuse_pct,
            system_unchanged=system_unchanged,
            history_lines_added=history_added,
            user_changed=user_changed,
            thought_vs_prev=thought_vs,
            action_vs_prev=action_vs,
            response_len_delta=resp_delta,
            cached_tokens=cached_tokens,
            new_tokens=new_token_est,
            summary_line=" | ".join(parts),
        )

    # -----------------------------------------------------------------
    # 记录 & 统计 — 每轮调用的数据持久化与会话级聚合
    # -----------------------------------------------------------------

    def record_turn(
        self,
        turn: int,
        question: str,
        prompt: str,
        raw_output: str,
        cleaned_output: str,
        thought: str,
        action: str,
        action_input: str,
        observation: str,
        prompt_tokens: int,
        completion_tokens: int,
        duration_ms: float,
        parse_error: Optional[str] = None,
        status: str = "success",
    ):
        """
        记录一轮 ReAct 调用的完整数据 — 这是追踪系统的核心入口。

        每次 LLM 调用完成后调用此方法, 自动完成:
          1. Prompt 结构分解 (_decompose_prompt)
          2. 跨轮 Diff 计算 (_compute_diff)
          3. TraceRecord 构造与存储
          4. 跨轮状态变量更新 (为下一轮 Diff 做准备)
          5. 终端即时输出 [DIFF] 摘要行

        参数:
          turn:              轮次编号 (从 1 开始)
          question:          原始用户问题 (在整个多轮对话中保持不变)
          prompt:            发送给 LLM 的完整 prompt 字符串
          raw_output:        LLM 返回的原始输出 (未经清洗)
          cleaned_output:    清洗后的输出 (已去除 <think> 等标签)
          thought:           解析出的推理过程 (parse error 时为 "(Parse Error)")
          action:            解析出的动作 (工具名 / "final_answer" / "none")
          action_input:      解析出的动作参数
          observation:       工具执行结果 (或 "(final answer)" / 错误信息)
          prompt_tokens:     prompt 侧 token 消耗 (来自 llama.cpp usage.prompt_tokens)
          completion_tokens: 响应侧 token 消耗 (来自 llama.cpp usage.completion_tokens)
          duration_ms:       LLM 调用耗时 (从发送 prompt 到收到完整响应的毫秒数)
          parse_error:       解析失败时的错误消息 (成功时为 None)
          status:            本轮状态: "success" | "parse_error" | "tool_error" | "max_steps"

        副作用:
          - self.records 追加一条 TraceRecord
          - self._last_* 全部更新为本轮数据
          - 终端打印 [DIFF] 行
        """
        # Step 1: Prompt 结构分解
        decomp = self._decompose_prompt(prompt)
        prev_decomp = self._last_decomp

        # Step 2: 计算与上一轮的差异
        diff = self._compute_diff(
            current=prompt, prev=self._last_prompt,
            decomp=decomp, prev_decomp=prev_decomp,
            thought=thought, action=action,
            completion_tokens=completion_tokens,
            response_len=len(cleaned_output),
        )

        # Step 3: 构造并存储 TraceRecord
        record = TraceRecord(
            turn=turn,
            question=question,
            timestamp=datetime.now().strftime("%H:%M:%S.%f")[:-3],  # 精确到毫秒, 去掉最后 3 位微秒
            prompt_full=prompt,
            prompt_snapshot=prompt[-500:],  # 只保留最后 500 字符作为快速预览
            raw_output=raw_output,
            cleaned_output=cleaned_output,
            thought=thought,
            action=action,
            action_input=action_input,
            observation=observation,
            prompt_tokens=prompt_tokens,
            completion_tokens=completion_tokens,
            duration_ms=duration_ms,
            decomp=decomp,
            diff=diff,
            parse_error=parse_error,
            status=status,
        )
        self.records.append(record)

        # Step 4: 更新跨轮状态 (为下一轮 Diff 做准备)
        self._last_prompt = prompt
        self._last_decomp = decomp
        self._last_response = cleaned_output
        self._last_thought = thought
        self._last_action = action

        # Step 5: 终端即时输出 diff 摘要
        if diff and turn > 1:
            # 非首轮: 打印完整的差异摘要行
            ts_print(f"[DIFF] {diff.summary_line}")
        elif diff and turn == 1:
            # 首轮: 只打印 prompt 初始结构 (无上一轮可对比)
            ts_print(f"[DIFF] initial prompt | system={decomp.system_len} chars | "
                  f"user={decomp.user_len} chars | history={decomp.history_len} chars")

    def summary(self) -> Dict[str, Any]:
        """
        计算会话级别的聚合统计摘要。

        聚合维度:
          - Token 用量: 所有轮次的 prompt/completion/total tokens 求和
          - 成本估算: 按 QWEN_PRICE 计算人民币成本
          - Cache 分析: 累计缓存命中 token 数 / 命中率 / 平均 prompt 复用率
          - 错误统计: 解析错误轮次数 / 工具调用轮次数
          - 异常检测: 系统提示词变化次数 (应为 0)

        返回:
          字典, 包含所有聚合指标, 供 print_summary() 和 export_html() 使用

        注意:
          - prompt 复用率排除首轮 (首轮无上一轮可对比, 复用率无定义)
          - cache_hit_rate = cached_tokens / (cached_tokens + new_tokens) × 100%
            (仅在首轮有意义的会话中可能偏高, 因为有固定的 system prompt 占据大量共享前缀)
        """
        total_turns = len(self.records)
        total_prompt = sum(r.prompt_tokens for r in self.records)
        total_completion = sum(r.completion_tokens for r in self.records)
        total_duration = sum(r.duration_ms for r in self.records)
        error_turns = [r for r in self.records if r.status != "success"]
        tool_calls = [r for r in self.records if r.action not in ("final_answer", "none", "")]

        # ═══ Cache 统计 ═══
        total_cached = sum(r.diff.cached_tokens for r in self.records if r.diff)
        total_new = sum(r.diff.new_tokens for r in self.records if r.diff)
        total_est_prompt_tokens = total_cached + total_new
        cache_hit_rate = (total_cached / total_est_prompt_tokens * 100) if total_est_prompt_tokens > 0 else 0.0
        # 系统提示词变化次数 — 应为 0, 非零表示存在 bug
        system_change_count = sum(1 for r in self.records if r.diff and not r.diff.system_unchanged)

        # 平均 prompt 复用率 — 排除首轮 (首轮无上一轮, 复用率无意义)
        reuse_rates = [r.diff.prompt_reuse_pct for r in self.records[1:] if r.diff]
        avg_reuse = sum(reuse_rates) / len(reuse_rates) if reuse_rates else 0.0

        return {
            "model": self.model_name,
            "session_duration_s": (datetime.now() - self.session_start).total_seconds(),
            "total_turns": total_turns,
            "total_prompt_tokens": total_prompt,
            "total_completion_tokens": total_completion,
            "total_tokens": total_prompt + total_completion,
            "total_duration_ms": total_duration,
            "error_turns": len(error_turns),
            "tool_calls": len(tool_calls),
            "cost_rmb": (total_prompt * QWEN_PRICE["input"] + total_completion * QWEN_PRICE["output"]) / 1000,
            # Cache 维度
            "estimated_cached_tokens": total_cached,
            "estimated_new_tokens": total_new,
            "cache_hit_rate": cache_hit_rate,
            "avg_prompt_reuse_pct": avg_reuse,
            "system_change_count": system_change_count,
        }

    def print_summary(self):
        """
        终端打印追踪摘要报告 — ASCII 艺术框, 含 Cache 可视化进度条。

        输出内容:
          上半部分: Token 用量 (prompt / completion / total)
          下半部分: Cache 分析 (cached tokens / new tokens / hit rate / reuse / system changes)
          底部:     成本 + 工具调用 + 错误 + LLM 耗时

        进度条:
          使用 Unicode 块元素 (█░) 绘制, 宽度 30 字符。
          cache_hit_rate 和 avg_prompt_reuse_pct 各有独立进度条。
        """
        s = self.summary()
        cache_bar = self._bar(s['cache_hit_rate'], 30)
        reuse_bar = self._bar(s['avg_prompt_reuse_pct'], 30)
        ts_print(f"""
╔══════════════════════════════════════════════════════════╗
║              ReAct Trace Report                          ║
╠══════════════════════════════════════════════════════════╣
║  Model: {s['model'][:46]:<46s} ║
║  Turns: {s['total_turns']:<5}  Duration: {s['session_duration_s']:.1f}s{'':>30s} ║
╠══════════════════════════════════════════════════════════╣
║  Token Usage                                            ║
║    Prompt tokens:      {s['total_prompt_tokens']:>8,d}                          ║
║    Completion tokens:  {s['total_completion_tokens']:>8,d}                          ║
║    Total:              {s['total_tokens']:>8,d}                          ║
╠══════════════════════════════════════════════════════════╣
║  Cache Analysis (estimated)                             ║
║    Cached tokens:      {s['estimated_cached_tokens']:>8,d}  [{cache_bar}] ║
║    New tokens:         {s['estimated_new_tokens']:>8,d}                          ║
║    Cache hit rate:     {s['cache_hit_rate']:>6.1f}%                             ║
║    Avg prompt reuse:   {s['avg_prompt_reuse_pct']:>6.1f}%  [{reuse_bar}] ║
║    System changes:     {s['system_change_count']} (should be 0)                          ║
╠══════════════════════════════════════════════════════════╣
║  Cost: ¥{s['cost_rmb']:.6f}  |  Tools: {s['tool_calls']}  |  Errors: {s['error_turns']}  |  LLM: {s['total_duration_ms']:.0f}ms ║
╚══════════════════════════════════════════════════════════╝
""")

    @staticmethod
    def _bar(pct: float, width: int) -> str:
        """
        绘制终端进度条 — 用于 print_summary 中的可视化展示。

        参数:
          pct:   百分比值 (0-100)
          width: 进度条总宽度 (字符数)

        返回:
          由 █ (已填充) 和 ░ (未填充) 组成的字符串

        示例:
          _bar(64.8, 10) → "██████░░░░"
        """
        filled = int(pct / 100 * width)
        return "█" * filled + "░" * (width - filled)

    # -----------------------------------------------------------------
    # HTML 导出 — 委托给专业 UX 渲染模块
    # -----------------------------------------------------------------

    def export_html(self, filepath: str):
        """
        导出自包含 HTML 可视化报告。

        实现: 委托给 ReActTraceRenderer.render_html(), 该模块负责:
          - Dark/Light 双主题 (CSS custom properties)
          - 设计系统驱动的卡片布局 (8px grid, Inter 字体)
          - 每轮 ReAct 的详细 Diff 面板 (9 维度指标)
          - Prompt 三段分解折叠面板
          - 原始输出折叠区
          - 主题切换按钮 (localStorage 持久化)

        参数:
          filepath: 输出 HTML 文件的绝对路径
        """
        from ReActTraceRenderer import render_html
        render_html(self.records, self.summary(), self.session_start, filepath)
        return

    @staticmethod
    def _escape(text: str) -> str:
        """
        HTML 实体转义 — 防止 XSS 和渲染错误。

        转义规则:
          & → &amp;  (必须第一个, 否则会重复转义)
          < → &lt;
          > → &gt;
          " → &quot;

        参数:
          text: 原始文本 (可能包含 HTML 特殊字符)

        返回:
          转义后的安全文本
        """
        return (text or "").replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace('"', '&quot;')

