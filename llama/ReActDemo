def init_llm():
    """
    初始化本地 LLM 实例 — 使用 llama-cpp-python 加载 GGUF 量化模型。

    加载流程:
      1. 检查模型文件是否存在
      2. 打印加载参数 (context / gpu_layers / threads)
      3. 调用 Llama() 构造函数加载模型
      4. 加载成功: 返回 Llama 实例
      5. 加载失败: 打印错误提示并退出

    硬件适配 (NVIDIA GB10 Grace Blackwell / DGX Spark):
      - n_ctx=32768:     上下文窗口 32K (GB10 121GB 统一内存, 充裕)
      - n_gpu_layers=-1:  全部层加载到 GPU (统一内存架构, 无 CPU↔GPU 拷贝开销)
      - flash_attn=True:  开启 Flash Attention (Blackwell 架构原生支持, 显著提升速度)
      - n_threads=10:     CPU 推理线程数 (GB10 20 核, 留 10 核给系统)
      - n_batch=1024:     批处理大小提升 (内存充裕)

    Qwen 模型特殊配置:
      - chat_format="qwen2": 必需! 否则模型不会正确解析 <|im_start|> / <|im_end|> 标记
      - rope_scaling_type=1: LLAMA_ROPE_SCALING_TYPE_LINEAR, 新版 llama-cpp-python 要求整数
      - repeat_penalty=1.15:  轻微抑制重复输出, 防止模型在 ReAct 循环中陷入复读

    返回:
      llama_cpp.Llama 实例 (已加载并可用)

    异常:
      FileNotFoundError: 模型文件不存在
      SystemExit(1):     模型加载过程中发生任何错误 (CUDA OOM / 参数错误 / 内存不足)
    """
    if not os.path.exists(MODEL_PATH):
        raise FileNotFoundError(f"[FATAL] Model file not found: {MODEL_PATH}\nCheck the path and try again.")

    ts_print(f"[INIT] Loading model: {MODEL_PATH}")
    ts_print(f"       context={N_CTX}  gpu_layers={N_GPU_LAYERS}  threads={N_THREADS}")

    try:
        llm = Llama(
            model_path=MODEL_PATH,
            n_ctx=N_CTX,                    # 上下文窗口 (字符数)
            n_gpu_layers=N_GPU_LAYERS,      # GPU 层数: -1=全部, 0=纯CPU
            n_threads=N_THREADS,             # CPU 线程数
            n_batch=N_BATCH,                 # 批处理大小 (影响吞吐)
            verbose=False,                          # 关闭 llama.cpp 详细日志, 避免污染输出
            chat_format="qwen2",                    # Qwen 系列专用 chat_template
            temp=TEMPERATURE,                       # 采样温度
            top_p=0.95,                             # nucleus sampling 阈值
            repeat_penalty=1.15,                    # 重复惩罚因子 (>1.0 = 抑制重复)
            rope_scaling_type=1,                    # RoPE 缩放类型: 1=LINEAR (适应超长上下文)
            flash_attn=True,                        # Flash Attention 加速 (Blackwell 架构原生支持)
        )
        ts_print("[INIT] Model loaded successfully.")
        return llm
    except Exception as e:
        ts_print(f"[FATAL] Model load failed: {e}")
        ts_print("[HINT] If CUDA OOM, try reducing N_CTX or set N_GPU_LAYERS=0 (CPU-only mode).")
        sys.exit(1)

