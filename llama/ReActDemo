@tool
def calculator(expression: str) -> str:
    """
    数学计算器工具 — 执行基本算术运算。

    功能:
      安全地 eval 数学表达式, 支持 + - * / ** () 等运算符。

    参数:
      expression: 数学表达式字符串, 例如 '2 + 2' 或 '10 * 5' 或 '(25 - 32) * 5 / 9'

    返回:
      计算结果字符串, 如 "4", "50", "-3.888888888888889"
      如果表达式非法, 返回 "Error: {错误信息}"

    安全措施:
      eval 时传入空 __builtins__ 字典, 阻止任意代码执行。
      只允许纯数学运算, 无法访问系统、文件、网络。
    """
    try:
        # {"__builtins__": {}} 是关键安全措施: 禁用所有内置函数, 只允许数学运算符
        result = eval(expression, {"__builtins__": {}}, {})
        return str(result)
    except Exception as e:
        return f"Error: {str(e)}"

@tool
def get_weather(city: str) -> str:
    """
    天气查询工具 — 获取指定城市的天气信息。

    功能:
      查询预设城市的天气数据 (模拟数据库, 非实时 API)。

    参数:
      city: 城市名 (英文), 如 "London", "Tokyo", "New York", "Paris"

    返回:
      天气描述字符串, 如 "Rainy, 12°C" 或 "Sunny, 25°C"
      如果城市不在数据库中, 返回 "Weather data not found for this city."

    注意:
      这是一个模拟工具, 实际部署时应替换为真实的天气 API 调用。
      模型可能错误地将非数据库中的城市名传入, 需要做好错误处理。
    """
    # 模拟数据库 — 生产环境中应替换为 API 调用
    weather_db = {
        "London": "Rainy, 12°C",
        "Tokyo": "Sunny, 25°C",
        "New York": "Cloudy, 18°C",
        "Paris": "Sunny, 20°C"
    }
    return weather_db.get(city, "Weather data not found for this city.")

# 注册所有可用工具
TOOLS = [calculator, get_weather]

